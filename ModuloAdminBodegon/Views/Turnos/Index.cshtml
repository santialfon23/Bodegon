@model IEnumerable<ModuloAdminBodegon.Models.TurnoLibre>

@{
    Layout = null;
    ViewData["Title"] = "Gestión de Turnos";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <title>@ViewData["Title"]</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.2.0/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.4.0/css/font-awesome.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Roboto:wght@400;700&display=swap" rel="stylesheet">
    <link href="~/css/style.css" rel="stylesheet">
</head>
<body>
    <div class="content-wrapper">
        <div id="cabecera">
            <div class="circulo-logo">
                <img src="~/imagenes/logo_chef_bodegon.png" alt="Logo" class="img-logo">
            </div>
            <h1>BODEGÓN DON MACANUDO</h1>
            <p class="subtitulo">— Gestión de Capacidad por Turno —</p>
        </div>

        <div class="container contenedor-principal" style="margin-top: 40px; margin-bottom: 40px; max-width: 800px;">
            <div class="row" style="margin-bottom: 25px;">
                <div class="col-xs-12">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-default"><i class="fa fa-arrow-left"></i> Volver al Panel Principal</a>
                </div>
            </div>

            <div class="panel panel-default" style="border-color: #8b0000; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
                <div class="panel-heading" style="background-color: #8b0000; color: white;">
                    <h3 class="panel-title" style="font-family: 'Playfair Display', serif; font-size: 20px;">
                        <i class="fa fa-users"></i> Turnos y Capacidad Máxima de Comensales
                    </h3>
                </div>
                <div class="panel-body" style="padding: 25px;">
                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr style="background-color: #f5f5f5;">
                                <th>Turno</th>
                                <th>Capacidad Máxima Actual</th>
                                <th class="text-center" style="width: 140px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><strong>@item.Turno</strong></td>
                                    <td><span class="badge" style="background-color: #8b0000; font-size: 14px;">@item.CapacidadMaxima personas</span></td>
                                    <td class="text-center">
                                        <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-warning btn-sm" style="color: white; background-color: #d9534f; border-color: #d43f3a;">
                                            <i class="fa fa-pencil"></i> Modificar
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div id="footer">
        <p><strong>Bodegón Don Macanudo</strong> — Pasaje Ficticio 1234 (Esquina Fantasía)</p>
        <p>Reservas: (011) 5555-4321 — Abierto de Martes a Domingos</p>
        <ul class="list-inline">
            <li><a href="https://instagram.com" target="_blank"><i class="fa fa-instagram"></i></a></li>
            <li><a href="https://facebook.com" target="_blank"><i class="fa fa-facebook"></i></a></li>
            <li><a href="https://whatsapp.com" target="_blank"><i class="fa fa-whatsapp"></i></a></li>
        </ul>
    </div>
</body>
</html>