@model IEnumerable<ModuloAdminBodegon.Models.Categoria>

@{
    Layout = null;
    ViewData["Title"] = "Menú - Bodegón Don Macanudo";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <title>@ViewData["Title"]</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.2.0/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.4.0/css/font-awesome.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Roboto:wght@400;700&display=swap" rel="stylesheet">
    <link href="~/css/style.css" rel="stylesheet">
</head>
<body>
    <div id="cabecera">
        <div class="circulo-logo">
            <img src="~/imagenes/logo_chef_bodegon.png" alt="Logo Bodegón Don Macanudo" class="img-logo">
        </div>
        <h1>BODEGÓN DON MACANUDO</h1>
        <p class="subtitulo">— Administración del Menú —</p>
    </div>

    <div class="container contenedor-principal" style="margin-top: 30px; margin-bottom: 40px;">
        <!-- Botones superiores -->
        <div class="row" style="margin-bottom: 25px; display: flex; align-items: center;">
            <div class="col-xs-6">
                <a asp-controller="Home" asp-action="Index" class="btn btn-default"><i class="fa fa-arrow-left"></i> Volver al Panel Principal</a>
            </div>
            <div class="col-xs-6 text-right">
                <a asp-action="CrearCategoria" class="btn btn-primary" style="background-color: #333; border-color: #222; margin-right: 8px;"><i class="fa fa-folder-o"></i> Nueva Categoría</a>
                <a asp-action="Crear" class="btn btn-danger" style="background-color: #8b0000; border-color: #700000;"><i class="fa fa-plus"></i> Agregar Nuevo Plato</a>
            </div>
        </div>

        <h2 style="font-family: 'Playfair Display', serif; margin-bottom: 25px; border-bottom: 2px solid #8b0000; padding-bottom: 10px;">
            Platos organizados por Categoría
        </h2>

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-warning text-center" style="padding: 20px; font-size: 16px;">
                <i class="fa fa-info-circle"></i> No hay categorías cargadas todavía. ¡Empezá creando una nueva categoría!
            </div>
        }
        else
        {
            @foreach (var categoria in Model)
            {
                <div class="panel panel-default" style="border-color: #8b0000; margin-bottom: 35px; box-shadow: 0 3px 6px rgba(0,0,0,0.15);">
                    <!-- Cabecera de la Categoría con el icono dinámico -->
                    <div class="panel-heading clearfix" style="background-color: #8b0000; color: white; padding: 12px 15px;">
                        <h3 class="panel-title pull-left" style="font-family: 'Playfair Display', serif; font-size: 22px; line-height: 30px;">
                            <i class="fa @(!string.IsNullOrEmpty(categoria.Icono) ? categoria.Icono : "fa-cutlery")"></i>
                            @categoria.Nombre
                            <small style="color: #f2f2f2; font-size: 14px; margin-left: 10px;">(Posición: @categoria.Posicion)</small>
                        </h3>
                        <div class="pull-right">
                            <a asp-action="EditarCategoria" asp-route-id="@categoria.Id" class="btn btn-default btn-xs" style="color: #333; font-weight: bold; margin-right: 5px;">
                                <i class="fa fa-pencil"></i> Modificar Categoría
                            </a>
                            <a asp-action="EliminarCategoria" asp-route-id="@categoria.Id" class="btn btn-danger btn-xs" style="background-color: #a94442; border-color: #982c2a;" onclick="return confirm('¿Estás seguro de eliminar esta categoría y todos sus platos?');">
                                <i class="fa fa-trash"></i> Borrar Categoría
                            </a>
                        </div>
                    </div>

                    <!-- Tabla de Platos de la Categoría -->
                    <div class="panel-body" style="padding: 0;">
                        @if (!categoria.ObtenerPlatos().Any())
                        {
                            <div class="text-center" style="padding: 30px; color: #777; font-style: italic;">
                                No hay platos cargados en esta categoría todavía.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive" style="margin-bottom: 0;">
                                <table class="table table-striped table-hover" style="margin-bottom: 0; vertical-align: middle;">
                                    <thead>
                                        <tr style="background-color: #f9f9f9;">
                                            <th style="width: 120px;">Imagen</th>
                                            <th>Plato</th>
                                            <th>Descripción</th>
                                            <th style="width: 120px;">Precio</th>
                                            <th style="width: 130px; text-align: center;">Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var plato in categoria.ObtenerPlatos())
                                        {
                                            <tr>
                                                <td style="vertical-align: middle;">
                                                    @if (!string.IsNullOrEmpty(plato.ImagenUrl))
                                                    {
                                                        <img src="~/imagenes/@plato.ImagenUrl" alt="@plato.Nombre" style="width: 60px; height: 50px; object-fit: cover; border-radius: 4px; border: 1px solid #ddd;" />
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted" style="font-size: 11px;">Sin imagen</span>
                                                    }
                                                </td>
                                                <td style="vertical-align: middle; font-weight: bold;">@plato.Nombre</td>
                                                <td style="vertical-align: middle; color: #555;">@plato.Descripcion</td>
                                                <td style="vertical-align: middle; font-weight: bold; color: #2c3e50;">$@plato.Precio.ToString("N2")</td>
                                                <td style="vertical-align: middle; text-align: center;">
                                                    <a asp-action="Editar" asp-route-id="@plato.Id" class="btn btn-primary btn-xs" style="background-color: #337ab7; border-color: #2e6da4;">
                                                        <i class="fa fa-pencil"></i> Editar
                                                    </a>
                                                    <a asp-action="Eliminar" asp-route-id="@plato.Id" class="btn btn-danger btn-xs" onclick="return confirm('¿Estás seguro de eliminar este plato?');">
                                                        <i class="fa fa-trash"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>

    <div id="footer">
        <p><strong>Bodegón Don Macanudo</strong> — Pasaje Ficticio 1234 (Esquina Fantasía)</p>
        <p>Reservas: (011) 5555-4321 — Abierto de Martes a Domingos</p>
        <ul class="list-inline">
            <li><a href="https://instagram.com" target="_blank"><i class="fa fa-instagram"></i></a></li>
            <li><a href="https://facebook.com" target="_blank"><i class="fa fa-facebook"></i></a></li>
            <li><a href="https://whatsapp.com" target="_blank"><i class="fa fa-whatsapp"></i></a></li>
        </ul>
    </div>
</body>
</html>