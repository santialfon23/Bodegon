@model ModuloAdminBodegon.Models.Plato

@{
    Layout = null;
    ViewData["Title"] = "Registrar Nuevo Plato";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <title>@ViewData["Title"]</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.2.0/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.4.0/css/font-awesome.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Roboto:wght@400;700&display=swap" rel="stylesheet">
    <link href="~/css/style.css" rel="stylesheet">
</head>
<body>
    <div class="content-wrapper">
        <div id="cabecera">
            <div class="circulo-logo">
                <img src="~/imagenes/logo_chef_bodegon.png" alt="Logo" class="img-logo">
            </div>
            <h1>BODEGÓN DON MACANUDO</h1>
            <p class="subtitulo">— Registrar Plato —</p>
        </div>

        <div class="container contenedor-principal" style="margin-top: 40px; margin-bottom: 40px; max-width: 650px;">
            <div class="row" style="margin-bottom: 25px;">
                <div class="col-xs-12">
                    <a asp-action="Index" class="btn btn-default"><i class="fa fa-arrow-left"></i> Volver al Menú</a>
                </div>
            </div>

            <div class="panel panel-default" style="border-color: #8b0000; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
                <div class="panel-heading" style="background-color: #8b0000; color: white;">
                    <h3 class="panel-title" style="font-family: 'Playfair Display', serif; font-size: 20px;">
                        <i class="fa fa-plus-circle"></i> Registrar Nuevo Plato
                    </h3>
                </div>
                <div class="panel-body" style="padding: 25px;">
                    <form asp-action="Crear" asp-controller="Menu" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom: 15px;"></div>
                        <div class="form-group">
                            <label asp-for="Nombre" class="control-label">Nombre del Plato</label>
                            <input asp-for="Nombre" class="form-control" required />
                        </div>

                        <div class="form-group">
                            <label asp-for="Descripcion" class="control-label">Descripción</label>
                            <textarea asp-for="Descripcion" class="form-control" rows="3" required></textarea>
                        </div>

                        <div class="form-group">
                            <label asp-for="Precio" class="control-label">Precio ($)</label>
                            <input asp-for="Precio" type="number" step="0.01" min="0.01" class="form-control" required />
                        </div>

                        <div class="form-group">
                            <label asp-for="CategoriaId" class="control-label">Categoría</label>
                            <select asp-for="CategoriaId" class="form-control" asp-items="ViewBag.Categorias"></select>
                        </div>

                        <div class="form-group">
                            <label class="control-label">Seleccionar Imagen del Plato</label>
                            <input type="file" name="imagenFile" class="form-control" accept="image/*" required />
                            <small class="text-muted">La imagen se guardará automáticamente en la carpeta de imágenes del sistema.</small>
                        </div>

                        <div class="form-group text-right" style="margin-top: 25px;">
                            <button type="submit" class="btn btn-success" style="background-color: #8b0000; border-color: #700000; padding: 10px 20px;">
                                <i class="fa fa-save"></i> Guardar Plato
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div id="footer">
        <p><strong>Bodegón Don Macanudo</strong> — Pasaje Ficticio 1234 (Esquina Fantasía)</p>
        <p>Reservas: (011) 5555-4321 — Abierto de Martes a Domingos</p>
        <ul class="list-inline">
            <li><a href="https://instagram.com" target="_blank"><i class="fa fa-instagram"></i></a></li>
            <li><a href="https://facebook.com" target="_blank"><i class="fa fa-facebook"></i></a></li>
            <li><a href="https://whatsapp.com" target="_blank"><i class="fa fa-whatsapp"></i></a></li>
        </ul>
    </div>
</body>
</html>