@model IEnumerable<ModuloAdminBodegon.Models.Reserva>
@{
    Layout = null;
    ViewData["Title"] = "Gestión de Reservas - Bodegón Don Macanudo";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <title>@ViewData["Title"]</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.2.0/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.4.0/css/font-awesome.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Roboto:wght@400;700&display=swap" rel="stylesheet">
    <link href="~/css/style.css" rel="stylesheet">
</head>
<body>
    <div id="cabecera">
        <div class="circulo-logo">
            <img src="~/imagenes/logo_chef_bodegon.png" alt="Logo Bodegón Don Macanudo" class="img-logo">
        </div>
        <h1>BODEGÓN DON MACANUDO</h1>
        <p class="subtitulo">— Panel de Administración - Gestión de Reservas —</p>
    </div>

    <div class="container" style="width: 95%; max-width: 1200px; margin-top: 30px;">
        
        <!-- Botones de navegación superior -->
        <div style="margin-bottom: 25px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
            <a asp-controller="Home" asp-action="Index" class="btn btn-default"><i class="fa fa-arrow-left"></i> Volver al Panel</a>
            <a asp-action="Create" class="btn btn-danger btn-lg"><i class="fa fa-plus-circle"></i> Cargar Reserva Presencial</a>
        </div>

        <div style="background: white; padding: 30px; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); width: 100%;">
            <h2 style="margin-top: 0; color: #8b0000; font-family: 'Playfair Display', serif;"><i class="fa fa-calendar"></i> Listado de Reservas por Día</h2>
            <p class="reserva-subtitulo" style="color: #666; margin-bottom: 25px;">Supervisión diaria y control operativo de reservas</p>

            <!-- Formulario de Filtros (Fecha y N° de Reserva) alineado -->
            <form asp-action="Index" method="GET" style="margin-bottom: 25px; background: #fcf8f8; padding: 15px; border-radius: 6px; border: 1px solid #f2dede; display: flex; flex-wrap: wrap; align-items: center; gap: 15px;">
                <div class="form-group" style="margin-bottom: 0; display: flex; align-items: center; gap: 8px;">
                    <label for="fechaFiltro" style="margin-bottom: 0; font-weight: 600;">Fecha:</label>
                    <input type="date" id="fechaFiltro" name="fechaFiltro" value="@ViewBag.FechaFiltro" class="form-control" style="width: auto;">
                </div>
                
                <div class="form-group" style="margin-bottom: 0; display: flex; align-items: center; gap: 8px;">
                    <label for="numeroReserva" style="margin-bottom: 0; font-weight: 600;">N° Reserva:</label>
                    <input type="text" id="numeroReserva" name="numeroReserva" value="@ViewBag.NumeroReserva" placeholder="Ej: #8306" class="form-control" style="width: 140px;">
                </div>

                <div style="display: flex; align-items: center; gap: 10px;">
                    <button type="submit" class="btn btn-danger"><i class="fa fa-search"></i> Buscar / Filtrar</button>
                    <a asp-action="Index" class="btn btn-link" style="color: #a94442; font-weight: 600; text-decoration: underline;">Ver Todas (Activas)</a>
                </div>
            </form>

            <div class="table-responsive" style="border: none;">
                <table class="table table-striped table-bordered" style="vertical-align: middle; width: 100%; margin-bottom: 0;">
                    <thead>
                        <tr style="background-color: #f5f5f5; color: #333;">
                            <th style="width: 110px;">N° Reserva</th>
                            <th>Fecha</th>
                            <th>Turno</th>
                            <th>Cliente</th>
                            <th>Personas</th>
                            <th>Teléfono / Contacto</th>
                            <th>Estado</th>
                            <th style="width: 110px; text-align: center;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><strong>@item.NumeroReserva</strong></td>
                                    <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td>@item.Turno</td>
                                    <td>@item.Cliente?.Nombre</td>
                                    <td><span class="badge" style="background-color: #a94442;">@item.CantidadPersonas</span></td>
                                    <td>@item.Cliente?.Telefono</td>
                                    <td>
                                        @if (item.Estado == EstadoReserva.Activa)
                                        {
                                            <span class="label label-success" style="font-size: 85%;">Activa</span>
                                        }
                                        else if (item.Estado == EstadoReserva.Cancelada)
                                        {
                                            <span class="label label-danger" style="font-size: 85%;">Cancelada</span>
                                        }
                                        else
                                        {
                                            <span class="label label-info" style="font-size: 85%;">Completada</span>
                                        }
                                    </td>
                                    <td style="text-align: center;">
                                        @if (item.Estado == EstadoReserva.Activa)
                                        {
                                            <form asp-action="Cancelar" asp-route-id="@item.Id" method="post" style="display:inline;">
                                                <button type="submit" class="btn btn-danger btn-xs" onclick="return confirm('¿Estás seguro de cancelar la reserva @item.NumeroReserva?');">
                                                    <i class="fa fa-times"></i> Cancelar
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted" style="padding: 30px; font-size: 15px;">No se encontraron reservas con los criterios seleccionados.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <div id="footer" style="margin-top: 40px; text-align: center; padding: 20px; color: #666;">
        <p><strong>Bodegón Don Macanudo</strong> — Pasaje Ficticio 1234 (Esquina Fantasía)</p>
        <p>Reservas: (011) 5555-4321 — Abierto de Martes a Domingos</p>
        <ul class="list-inline">
            <li><a href="https://instagram.com" target="_blank"><i class="fa fa-instagram"></i></a></li>
            <li><a href="https://facebook.com" target="_blank"><i class="fa fa-facebook"></i></a></li>
            <li><a href="https://whatsapp.com" target="_blank"><i class="fa fa-whatsapp"></i></a></li>
        </ul>
    </div>
</body>
</html>